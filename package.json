{
  "name": "@sneakers-pam/mock-server",
  "version": "0.0.0",
  "description": "Standalone in-memory mock of the whole Sneakers gateway API, shared by web, iOS and Android",
  "author": "The Sneakers-PAM Authors",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "sneakers-mock-server": "bin/sneakers-mock-server.mjs"
  },
  "exports": {
    "./in-process": "./packages/mock-gateway/src/index.ts",
    "./in-process/edge": "./packages/mock-gateway/src/edge.server.ts",
    "./in-process/testing": "./packages/mock-gateway/src/testing.ts",
    "./testing": "./packages/mock-gateway/src/pure.ts"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "node bin/sneakers-mock-server.mjs",
    "start:https": "bash scripts/dev-cert.sh && node bin/sneakers-mock-server.mjs --https-port 5443",
    "certs": "bash scripts/dev-cert.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "schema:copy": "bash scripts/schema-copy.sh",
    "schema:generate": "bash scripts/schema-generate.sh",
    "ios:operations": "node scripts/ios-operations.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sneakers-PAM/sneakers-mock-server.git"
  },
  "homepage": "https://github.com/Sneakers-PAM/sneakers-mock-server#readme",
  "bugs": {
    "url": "https://github.com/Sneakers-PAM/sneakers-mock-server/issues"
  },
  "dependencies": {
    "graphql": "^17.0.2",
    "msw": "^3.0.1",
    "vite": "^8.3.2",
    "vite-node": "3.2.4"
  },
  "devDependencies": {
    "@bugs5382/node-oxlint-config": "^1.0.1",
    "@graphql-codegen/cli": "^7.4.3",
    "@graphql-codegen/client-preset": "^6.2.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.9",
    "@types/node": "^26.6.4",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "typescript": "~6.0",
    "vitest": "^5.0.3"
  }
}
