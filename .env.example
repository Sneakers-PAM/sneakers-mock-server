# Every setting the server reads, with its local default.
PORT=5171
# Set to turn on the https listener (needs `npm run certs`). `npm run start:https` uses 5443.
HTTPS_PORT=
# Loopback by default: the controls have no sign-in. The image sets 0.0.0.0.
HOST=127.0.0.1
# Extra names for the https certificate, for a real device: MOCK_TLS_HOSTS="mac.example.org"
MOCK_TLS_HOSTS=
MOCK_SESSION_COOKIE=sneakers_sid
LOG_LEVEL=trace
LOG_FORMAT=console
